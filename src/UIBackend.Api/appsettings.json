{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "UIBackendDatabase": "Host=localhost;Port=5436;Database=visionx_uibackend;Username=postgres;Password=postgres"
  },
  "Storage": {
    "BasePath": "./media_storage"
  },
  "Jwt": {
    "Issuer": "https://visionx.samstack.site/auth",
    "Audience": "visionx-app",
    "JwksUrl": "https://visionx.samstack.site/auth/.well-known/jwks.json",
    "PublicKeyPath": "/opt/VisionX/secrets/jwt_public.pem"
  },
  "C2pa": {
    "Issuer": "VisionX Trust Authority",
    "CertificatePath": "/opt/VisionX/secrets/c2pa_cert.pem",
    "PrivateKeyPath": "/opt/VisionX/secrets/c2pa_private.pem"
  },
  "SynthId": {
    "Endpoint": "",
    "ApiKey": ""
  },
  "Notifications": {
    "BaseUrl": "https://visionx.samstack.site/notifs",
    "WebhookSecret": "VisionX_SessionEvent_SharedSecret_2026"
  },
  "MlService": {
    "BaseUrl": "https://visionx.samstack.site/ML",
    "ApiKey": "VisionX_ML_Service_Key_2026",
    "CallbackUrl": "https://visionx.samstack.site/a/api/ml/events"
  },
  "AlertPolicy": {
    "InfoMaxAnomalyScore": 0.40,
    "WarningMaxAnomalyScore": 0.75,
    "CriticalAnomalyTypes": [ "weapon", "fire", "intrusion", "violence", "fall" ],
    "NotificationCooldownSeconds": 120,
    "NotifyOnInfo": false,
    "NotifyOnWarning": true,
    "NotifyOnCritical": true
  },
  "Monitoring": {
    "AllowPrivateNetworks": false,
    "AllowedPrivateHosts": "",
    "EnableDevTestEndpoints": true
  }
}
