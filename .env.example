# PostgreSQL Configuration
POSTGRES_DB=visionx_uibackend
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5436

# UIBackend Service Configuration
UIBACKEND_PORT=8020
ASPNETCORE_ENVIRONMENT=Production

# Auth & JWT Configuration
JWT_ISSUER=https://visionx.samstack.site/auth
JWT_AUDIENCE=visionx-app
JWT_JWKS_URL=https://visionx.samstack.site/auth/.well-known/jwks.json
JWT_SECRETS_DIR=/opt/VisionX/secrets
JWT_PUBLIC_KEY_PATH=/opt/VisionX/secrets/jwt_public.pem

# Storage Configuration
MEDIA_STORAGE_PATH=/opt/visionx/media

# C2PA Provenance Authority
C2PA_ISSUER=VisionX Trust Authority
C2PA_CERT_PATH=/opt/VisionX/secrets/c2pa_cert.pem
C2PA_PRIVATE_KEY_PATH=/opt/VisionX/secrets/c2pa_private.pem

# Notifications Integration
NOTIFICATIONS_BASE_URL=https://visionx.samstack.site/notifs
SESSION_WEBHOOK_SECRET=VisionX_SessionEvent_SharedSecret_2026

# ML Service Integration
ML_SERVICE_BASE_URL=https://visionxml.samstack.site
ML_SERVICE_API_KEY=VisionX_ML_Service_Key_2026
STREAM_CREDENTIAL_KEY=change-this-32-char-encryption-key
Monitoring__AllowPrivateNetworks=false
Monitoring__EnableDevTestEndpoints=false

# Google SynthID (optional)
SYNTHID_ENDPOINT=
SYNTHID_API_KEY=
